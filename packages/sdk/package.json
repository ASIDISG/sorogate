{
  "name": "@sorogate/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript model of Sorogate access policies: validation, evaluation and decoding, held to the contract by shared test vectors.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:random": "tsx scripts/generate-random.ts",
    "testnet:differential": "tsx scripts/testnet-differential.ts",
    "testnet:gated-claim": "tsx scripts/testnet-gated-claim.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
