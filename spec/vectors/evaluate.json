  "cases": [
    {
      "name": "token balance exactly at the minimum is allowed",
      "policy": {
        "conditions": [
          {
            "type": "token_balance",
            "token": "gold",
            "min": "100"
          }
        ]
      },
      "subject": "alice",
      "expect": {
        "allowed": true,
        "version": 1,
        "failedIndex": null,
        "reason": "None"
      }
    },
    {
      "name": "token balance one below the minimum is denied as below minimum",
      "policy": {
        "conditions": [
          {
            "type": "token_balance",
            "token": "gold",
            "min": "100"
          }
        ]
      },
      "subject": "bob",
      "expect": {
        "allowed": false,
        "version": 1,
        "failedIndex": 0,
        "reason": "BelowMinimum"
      }
    },
