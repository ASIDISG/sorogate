{
  "schema": 1,
  "description": "Decisions for stored policies: what evaluate returns for a subject, given the state of the world. See README.md for the format.",
  "tokens": {
    "gold": {
      "kind": "i128",
      "balances": {
        "alice": "100",
        "bob": "99",
        "carol": "101",
        "frank": "0"
      }
    },
    "whale": {
      "kind": "i128",
      "balances": {
        "alice": "170141183460469231731687303715884105727"
      }
    },
    "badge": {
      "kind": "u32",
      "balances": {
        "alice": 2,
        "bob": 1,
        "carol": 0
      }
    },
    "wide": {
      "kind": "u64"
    },
    "broken": {
      "kind": "panics"
    },
    "nofn": {
      "kind": "no_balance_function"
